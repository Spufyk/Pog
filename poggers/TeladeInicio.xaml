<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="poggers.TeladeInicio"
             BackgroundColor="#333333"
             Shell.NavBarIsVisible="false">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <StackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center">
            <Label Text="Bem Vindo ao 'Site Y'!" TextColor="White" FontSize="24" HorizontalOptions="Center" Margin="0,0,0,30"/>
            <Button Text="Checklist"
                    BackgroundColor="White"
                    TextColor="Black" 
                    WidthRequest="200"
                    HeightRequest="50"
                    Clicked="OnTelaChecklistClicked"/>

            <Button Text="Tempo de produção"
                    BackgroundColor="White"
                    TextColor="Black"
                    WidthRequest="200"
                    HeightRequest="50"
                    Margin="0,10,0,0"
                    Clicked="OnTelaTempodeProducaoClicked"/>

            <Button Text="Cliente"
                    BackgroundColor="White"
                    TextColor="Black"
                    WidthRequest="200"
                    HeightRequest="50"
                    Margin="0,10,0,0"
                    Clicked="OnTelaClienteClicked"/>

            <Button Text="Produto"
                    BackgroundColor="White"
                    TextColor="Black"
                    WidthRequest="200"
                    HeightRequest="50"
                    Margin="0,10,0,0"
                    Clicked="OnTelaProdutoClicked"/>
        </StackLayout>
        
    </Grid>
</ContentPage>

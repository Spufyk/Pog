<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="poggers.ChecklistPage"
             BackgroundColor="#333333"
             Title="Checklist">

    <Grid Padding="20"
            RowSpacing="10"
            ColumnSpacing="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Label Text="Checklist"
               Grid.Row="0"
               FontSize="24"
               TextColor="White"
               HorizontalOptions="Center"
               Margin="0,10,0,20"/>

        <!-- Search Bar -->
        <SearchBar Grid.Row="1"
                   Placeholder="Procurar Cliente"
                   BackgroundColor="White"
                   x:Name="ClienteSearchBar"/>

        <!-- Product List -->
        <Frame Grid.Row="2"
               BackgroundColor="White"
               CornerRadius="15"
               Padding="10"
               HasShadow="True"
               Margin="0,20">
            <StackLayout Spacing="15">
                <StackLayout Orientation="Horizontal"
                        Spacing="20">
                    <Label Text="Produto X"
                            VerticalOptions="Center"/>
                    <CheckBox x:Name="ProdutoXCheckBox"
                            IsChecked="True"
                            VerticalOptions="Center"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal"
                        Spacing="20">
                    <Label Text="Produto Y"
                            VerticalOptions="Center"/>
                    <CheckBox x:Name="ProdutoYCheckBox"
                            IsChecked="True"
                            VerticalOptions="Center"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal"
                        Spacing="20">
                    <Label Text="Produto W"
                            VerticalOptions="Center"/>
                    <CheckBox x:Name="ProdutoWCheckBox"
                            IsChecked="True"
                            VerticalOptions="Center"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal"
                        Spacing="20">
                    <Label Text="Produto Z"
                            VerticalOptions="Center"/>
                    <CheckBox x:Name="ProdutoZCheckBox"
                            IsChecked="True"
                            VerticalOptions="Center"/>
                </StackLayout>
            </StackLayout>
        </Frame>

        <!-- Buttons -->
        <StackLayout Orientation="Horizontal"
                     Grid.Row="3"
                     HorizontalOptions="Center"
                     Margin="0,20,0,0">
            <Button Text="Voltar"
                    BackgroundColor="#0000FF"
                    TextColor="White"
                    Clicked="OnVoltarClicked"
                    Margin="0,0,10,0"/>
            <Button Text="Salvar"
                    BackgroundColor="#00FF00"
                    TextColor="White"
                    Clicked="OnSalvarClicked"/>
        </StackLayout>

    </Grid>

</ContentPage>
